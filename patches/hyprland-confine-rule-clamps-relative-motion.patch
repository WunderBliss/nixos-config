+std::optional<Vector2D> CPointerConstraintController::ruleClamp(const Vector2D& position) const {
+    const auto SURFACE = activeSurface();
+    if (!SURFACE)
+        return std::nullopt;
+
+    // Native constraints are what the client asked for; keep protocol semantics there.
+    const auto NATIVE = m_native.lock();
+    if (NATIVE && NATIVE->isActive())
+        return std::nullopt;
+
+    const auto RULEWINDOW = ruleWindow(SURFACE);
+    if (!RULEWINDOW)
+        return std::nullopt;
+
+    // A hidden cursor means the client is doing mouselook from raw deltas and wants them
+    // uncut, the same as a lock would give it. Only a visible cursor gets clamped.
+    const auto& IMAGE = Pointer::mgr()->currentCursorImage();
+    if (!IMAGE.surface && !IMAGE.pBuffer)
+        return std::nullopt;
+
+    const auto RULEBOX = RULEWINDOW->wlSurface()->getSurfaceBoxGlobal();
+    if (!RULEBOX)
+        return std::nullopt;
+
+    return CRegion(*RULEBOX).closestPoint(position);
+}
+
 void CPointerConstraintController::enforce() {
     apply(Time::millis(Time::steadyNow()), g_pInputManager->getMouseCoordsInternal());
 }
